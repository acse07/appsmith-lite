generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  name         String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     Session[]
  memberships  WorkspaceMember[]
  workspaces   Workspace[]
  applications Application[]
}

model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  slug         String            @unique
  ownerId      String            @db.Uuid
  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  members      WorkspaceMember[]
  applications Application[]
  sources      DataSource[]
}

model WorkspaceMember {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(VIEWER)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Application {
  id                 String       @id @default(uuid()) @db.Uuid
  workspaceId        String       @db.Uuid
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  description        String       @default("")
  color              String       @default("orange")
  createdById        String       @db.Uuid
  createdBy          User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  publishedVersionId String?      @unique @db.Uuid
  publishedVersion   AppVersion?  @relation("ActiveVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions           AppVersion[] @relation("Versions")
  pages              Page[]
  queries            Query[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, updatedAt])
}

model Page {
  id        String      @id @default(uuid()) @db.Uuid
  appId     String      @db.Uuid
  app       Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  name      String
  position  Int         @default(0)
  document  Json
  revision  Int         @default(0)
  updatedAt DateTime    @updatedAt

  @@index([appId, position])
}

model DataSource {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  kind        String
  config      Json
  queries     Query[]

  @@index([workspaceId])
}

model Query {
  id       String      @id @default(uuid()) @db.Uuid
  appId    String      @db.Uuid
  app      Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  sourceId String      @db.Uuid
  source   DataSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  name     String
  config   Json

  @@unique([appId, name])
}

model AppVersion {
  id        String       @id @default(uuid()) @db.Uuid
  appId     String       @db.Uuid
  app       Application  @relation("Versions", fields: [appId], references: [id], onDelete: Cascade)
  activeFor Application? @relation("ActiveVersion")
  number    Int
  snapshot  Json
  createdAt DateTime     @default(now())

  @@unique([appId, number])
}
